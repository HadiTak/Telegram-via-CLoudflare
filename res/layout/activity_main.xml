<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <Button
        android:id="@+id/btnHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="راهنمای کامل تنظیم (گیت‌هاب + Cloudflare)" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="کلید مشترک (همون چیزی که در Cloudflare به‌عنوان AUTH_KEY ست کردید):"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="یه رشته‌ی طولانی و تصادفی"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/btnGenKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ساخت کلید تصادفی و کپی" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="آدرس Cloudflare Worker (بدون wss:// و بدون /apiws):"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etWorker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="example.username.workers.dev"
        android:inputType="textUri" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="پورت محلی SOCKS5 (پیش‌فرض 1080):"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="1080"
        android:inputType="number" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="فعال کردن" />

    <Button
        android:id="@+id/btnOpenTelegram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="باز کردن در تلگرام و ست کردن پروکسی" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="14sp"
        android:text="وضعیت: غیرفعال" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="12sp"
        android:text="بعد از فعال‌سازی، دکمه‌ی «باز کردن در تلگرام» رو بزن، یا دستی برو: Settings → Data and Storage → Proxy → Add Proxy → SOCKS5 → Server: 127.0.0.1 → Port: همون پورت بالا" />

</LinearLayout>
